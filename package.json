{
  "name": "study-to-go",
  "version": "1.0.0",
  "private": true,
  "description": "Study To-Go: flashcards and an AI study assistant",
  "scripts": {
    "validate:html": "html-validate \"index.html\" \"pages/*.html\"",
    "lint": "eslint js",
    "test": "node --test tests/studyOrganizer.test.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run validate:html && npm run lint"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "html-validate": "^9.0.0",
    "prettier": "^3.0.0"
  }
}
